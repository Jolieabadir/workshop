# Workshop — Environment Variables
# Copy this to .env.local and fill in your keys

# Anthropic (Claude API for Builder agent)
ANTHROPIC_API_KEY=

# Deepgram (Speech-to-text and Text-to-speech)
DEEPGRAM_API_KEY=

# Tripo (AI 3D mesh generation — optional, get free key at https://tripo3d.ai)
TRIPO_API_KEY=

# Scatter mode (feedback loop testing — set to 'true' to scatter parts on spawn)
# NEXT_PUBLIC_SCATTER_INITIAL=true
