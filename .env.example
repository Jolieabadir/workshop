# Workshop — Environment Variables
# Copy this to .env.local and fill in your keys

# Anthropic (Claude API for Builder agent)
ANTHROPIC_API_KEY=

# Deepgram (Speech-to-text and Text-to-speech)
DEEPGRAM_API_KEY=

# Meshy (AI 3D mesh generation — optional, get free key at https://meshy.ai)
MESHY_API_KEY=
